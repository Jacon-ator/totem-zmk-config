//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Num         2


&mt {
    quick-tap-ms = <100>;
    require-prior-idle-ms = <125>;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos { 
        compatible = "zmk,combos";
        combo_enter {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&kp ENTER>;
        };
     };

    macros {
        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp C>
                , <&macro_release &kp LCTRL>
                ;
        };

        paste: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp V>
                , <&macro_release &kp LCTRL>
                ;
        };
    };


    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            // ---------------------------------------------------------------------------------------------------------------------------------------------------------
            // |           |     Q     |     W     |     E     |     R     |     T     |     Y     |     U     |     I     |     O     |     P     |           |
            // |           |     A     |   S/TAB   |  D/LALT   | F/LCTRL   |     G     |     H     | J/RCTRL   |  K/RALT   |   L/TAB   | ;(ENTER)  |           |
            // |   `/~     |     Z     |     X     |     C     |     V     |     B     |     N     |     M     |     ,     |   ./[!]   |    //\    |   RGUI    |
            // |                                   |    NUM    |   BSPC    |    NAV    |  RSHIFT   |   SPACE   |           |                                   |
            bindings = <
                &kp Q   &kp W       &kp E          &kp R         &kp T        &kp Y       &kp U        &kp I        &kp O                    &kp P
                &kp A   &hm TAB S   &hm LALT D     &hm LCTRL F   &kp G        &kp H       &hm RCTRL J  &hm RALT K   &hm TAB L                &mt ENTER SEMICOLON
&kp GRAVE       &kp Z   &kp X       &kp C          &kp V         &kp B        &kp N       &kp M        &kp COMMA    &mt EXCLAMATION DOT      &mt BACKSLASH SLASH   &kp RGUI
                                    &mo 2          &kp BSPC      &mo 1        &kp RSHIFT  &kp SPACE    &kp MINUS
            >;
        };

        Nav {
            display-name = "Nav";
            // ---------------------------------------------------------------------------------------------------------------------------------------------------------
            // |           |    ESC    |           |           |           |           |           |           |    UP     |    DEL    |    HOME   |           |
            // |           |           |           |           |           |           |           |   LEFT    |   DOWN    |   RIGHT   |    END    |           |
            // |           |           |           |    copy   |   paste   |           |           |           |           |           |           |           |
            // |                                   |           |           |           |           |           |           |                                   |
            bindings = <
                &kp ESC   &trans  &trans    &trans      &trans      &kp K_PLAY_PAUSE &trans         &kp UP_ARROW    &kp DEL         &kp HOME
                &trans    &trans  &trans    &trans      &trans      &trans           &kp LEFT_ARROW &kp DOWN_ARROW  &kp RIGHT_ARROW &kp END 
&trans          &trans    &trans  &copy     &paste      &trans      &trans           &trans         &trans          &trans          &trans  &trans
                                  &trans    &trans      &trans      &trans           &trans         &trans
        
        };

        Num {
            display-name = "Num";
            // ---------------------------------------------------------------------------------------------------------------------------------------------------------
            // |           |           |           |     (     |     )     |           |     *     |     7     |     8     |     9     |    =/+    |           |
            // |           |           |           |     [     |     ]     |           |    '/"    |     4     |     5     |     6     |    -/_    |           |
            // |           |           |           |     {     |     }     |           |     @     |     1     |     2     |     3     |           |           |
            // |                                   |           |           |           |           |           |     0     |                                   |
            bindings = <
                &trans       &trans     &kp LPAR      &kp RPAR   &trans      &kp ASTERISK      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp EQUAL
                &trans       &trans     &kp LBKT      &kp RBKT   &trans      &kp SINGLE_QUOTE  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS
&trans          &trans       &trans     &kp LBRC      &kp RBRC   &trans      &kp AT            &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans
                                        &trans        &trans     &trans      &trans            &trans        &kp NUMBER_0
                                  
            >;
        };
    };
};

