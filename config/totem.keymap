#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
// FIX 1: Added required include for studio_unlock
#include <behaviors/studio_unlock.dtsi>

#define Base        0
#define Nav         1
#define Num         2


&mt {
    quick-tap-ms = <100>;
    require-prior-idle-ms = <125>;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            // FIX 2: Replaced deprecated global-quick-tap with require-prior-idle-ms
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos { 
        compatible = "zmk,combos";
        combo_enter {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp ENTER>;
        };
     };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
                &kp Q   &kp W       &kp E          &kp R         &kp T        &kp Y       &kp U        &kp I        &kp O                    &kp P
                &kp A   &hm TAB S   &hm LALT D     &hm LCTRL F   &kp G        &kp H       &hm RCTRL J  &hm RALT K   &hm TAB L                &mt ENTER SEMICOLON
&kp GRAVE       &kp Z   &kp X       &kp C          &kp V         &kp B        &kp N       &kp M        &kp COMMA    &mt EXCLAMATION DOT      &kp SLASH           &kp RGUI
                                    &mo 2          &kp BSPC      &mo 1        &kp RSHIFT  &kp SPACE    &kp MINUS
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
                &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPERSAND  &kp UP_ARROW    &kp SQT  &kp DQT
                &trans    &trans  &trans    &trans      &trans         &trans     &kp LEFT       &kp DOWN        &kp RIGHT   &trans
&studio_unlock  &trans    &trans  &trans    &trans      &trans         &kp UNDER  &kp EQUAL      &trans          &trans   &kp SLASH  &kp HOME
                                  &trans    &trans      &trans         &trans     &trans         &trans
            >;
        };

        Num {
            display-name = "Num";
            bindings = <
                &kp TILDE       &trans     &kp UP_ARROW  &trans     &kp LBRC    &kp RBRC  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans
                &kp LEFT_SHIFT  &kp LEFT   &kp DOWN      &kp RIGHT  &kp LBKT    &kp RBKT  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans
&kp LEFT_ALT    &kp LEFT_WIN    &kp MINUS  &trans        &kp PLUS   &kp LPAR    &kp RPAR  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans
                                           &trans        &trans     &trans      &trans    &trans        &kp NUMBER_0
            >;
        };
    };
};
